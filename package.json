{
  "name": "marketplace-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BitYuan 联邦商城节点：任何人可部署的店铺 API 服务（Express + MySQL 8）",
  "engines": {
    "node": ">=23.4"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node scripts/test-all.mjs",
    "check:integrity": "node --env-file-if-exists=.env scripts/check-integrity.js",
    "auto-confirm": "node --env-file-if-exists=.env scripts/auto-confirm.mjs",
    "e2e": "node --env-file-if-exists=.env scripts/e2e-mainnet.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "mysql2": "^3.24.6"
  },
  "overrides": {
    "qs": "^6.16.0",
    "proxy-addr": "^2.0.8"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}

