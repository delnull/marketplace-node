# ===== BitYuan 联邦商城节点配置样例（配置极简：只放「身份与接线」）=====
# 复制为 .env 后按需修改；`node --env-file-if-exists=.env` 自动加载（缺失时用默认值）
#
# 经营参数一律不在本文件：
#   店名/公告/店员名单/通知 webhook   → 卖家面板「店铺设置」网页编辑（存节点本地库，即改即生效）
#   登记 endpoint                    → 开店向导网页填写（链上登记不含展示资料，无需配置/同步）

# HTTP 端口
MK_PORT=8080

# ── 节点身份（必填）──
# 节点主 / operator 钱包（node.owner）：启动必填，缺失即拒绝启动；链上 registerNode 的 operator
# 应与它是同一个钱包。它是节点级身份与抽成收款人，**不是每家店的店主**（店铺店主是 shops.seller，
# 货款归店主）；换节点登记走链上 transferNode（它不转让店铺）。改本文件的值不会改链上 operator。
# 请勿填 0x000…0 占位（非空会被当作"已配置"）。
MK_SHOP_OWNER=

# ── 链上（BTY EVM 主网）──
MK_RPC_URL=https://mainnet.bityuan.com/eth
MK_CHAIN_ID=2999
# 部署 Escrow/Registry 合约后填入（见 docs/DEPLOY_NODE.md「链上部署与登记」）。
# 均为必填：Escrow = 买家资金锁定的 canonical 托管；Registry = 开店登记目录。
# 必须与配套前端 VITE_ESCROW_ADDRESS / VITE_REGISTRY_ADDRESS 一致（同网络），否则开店向导拒绝登记。
# 注意：请勿填 0x000…0 占位——非空即视为已接入（会启动事件轮询/开放登记条件）
MK_ESCROW_ADDRESS=
MK_REGISTRY_ADDRESS=
# 链上黑名单合约（Blocklist，owner 维护、全网共享）：地址类拒单闸与商品类列表过滤都读它。
# **部署脚本把它当必填**（deploy.sh / deploy.ps1 空值即拒绝部署）。若你手工维护 .env 并绕过
# 部署脚本把它留空，节点仍会启动，但这两道闸整体不生效且不报错（`chain.getBlocklist` 只在真去读名单时才抛错）。
# 它同时是 Registry 构造函数的 immutable BLOCKLIST，必须与 Registry 同批部署；配套前端
# 的 VITE_BLOCKLIST_ADDRESS 必须是同一个地址（否则前端与节点读的不是同一份名单）。
MK_BLOCKLIST_ADDRESS=
# 换托管合约地址时的显式确认（默认不要设）：启动时节点会把 MK_ESCROW_ADDRESS 记进库（node.escrow_address 锚点），
# 下次启动若发现地址变了、而本地还有**已上链的在途订单**（escrowed/shipped/disputed），默认**拒绝启动**
# ——那些单的托管资金在旧合约实例上，换个地址查不到也对不了账。显式设 1 才继续（后果自负，见报错正文）。
MK_ESCROW_CHANGE_ACK=
# 旧合约代次放行（默认不要设）：启动期会分别自检托管合约与 Registry 的代次（缺本版本需要的入口时
# 默认拒绝启动），并在下单超时窗口配置确定越界时拒绝启动。只有明确知道接的是旧实例、仍要以只读
# 方式接，才设 MK_CONTRACT_GEN_ACK=1；它会**同时**放行这三道自检，不要为一个变量把它们一起关掉。
# 部署脚本（deploy.sh / deploy.ps1）不管理这个键，重跑时原样保留。
MK_CONTRACT_GEN_ACK=
# 支付币种：原生 BTY（Escrow 仅接受 msg.value 入金，无币种配置）

# ── 托管参数 ──
# 托管超时（区块数）：BTY 5 秒/块 → 7 天 ≈ 120960
MK_ESCROW_TIMEOUT_BLOCKS=120960
# 事件轮询间隔（毫秒）
MK_ESCROW_POLL_MS=15000
# 起始扫描块（0=从当前最新块开始；建议填 Escrow 部署块高度避免漏扫历史事件）
MK_ESCROW_START_BLOCK=0

# 确认深度（区块数，默认 12；0 = 关闭）：只处理「链头 − N 块」之前的事件。
# 重组只回放日志不回滚已落地的终态，等 N 块再处理可从源头规避短重组造成的镜像错位；
# 代价是状态回写延迟约 N×5 秒（本地 anvil 演示请设 0，见 scripts/dev/dev-demo.mjs）。
MK_ESCROW_FINALITY_BLOCKS=12

# ── 订单 ──
# 草稿订单（已锁定未支付）自动关闭 TTL（分钟）：超时未支付置为 cancelled
MK_DRAFT_TTL_MINUTES=30
# 卡密自动交付：默认开——数字商品买家托管成功（链上 OrderCreated 回写/paid 确认）后，
# 码池有未用码则自动分配发码置 shipped，免卖家手动发货；置 0 关闭（仅手动交付）
MK_AUTO_DELIVER=1
# 成交订单可评价窗口（天，P0-1）：终局（确认收货/仲裁判付/超时释放）起 N 天内买家可评价
MK_REVIEW_TTL_DAYS=30
# 陈述时限（天，默认 7；0 = 关闭）：**自进入争议或售后案件开案起** N 天内可提交陈述与证据附件，
# 过期提交被拒（拒因写明"第 N 天、过期视为放弃举证"）。两个阶段的起算时刻都取本地已镜像的链上时刻
# （争议=watcher 回写 disputed 的时刻；案件=AfterSaleOpened 落库时刻），不另算一套。
# 置 0 = 不限时（恢复加这个配置之前的行为；订单详情里的倒计时字段同时为 null）。
MK_DISPUTE_STATEMENT_DAYS=7

# ── 下单风控闸（可选，**默认关闭**；运营方自己的准入策略）──
# 语义：填了地址就当「本店要先问过自己的风控服务才肯卖」。每笔**草稿创建前**（本地校验已过、
# 库存尚未占用——被拒的单既不留订单行也不占库存），本节点向该地址 POST JSON：
#   { event:'order.gate', buyer, seller, productSlug, skuKey, quantity, amountWei,
#     usdtMicro, shippingFeeUsdtMicro, at }
#   金额单位：amountWei = 原生 BTY 的最小单位（wei）；usdtMicro / shippingFeeUsdtMicro = **微 USDT**
#   （1 USDT = 1e6）——按这两个整数判限额，不要当"分"或"元"解读。
# **不含**收货人姓名/电话/地址与买家备注（风控不该成为个人信息外流通道）。
# 响应契约：HTTP 200 + JSON {"allow":true} → 放行；{"allow":false,"reason":"…"} → 拒单
# （reason 会展示给买家，前缀「本店风控未放行：」）；其它状态/形态（含 3xx 重定向、非 JSON、
# allow 缺失）一律拒单并在消息里带出实际 HTTP 状态。
# fail-closed：地址一旦配置，风控服务不可达 / 超时 / 应答异常都会**拒绝下单**——宁可少卖，
# 也不在风控失效时静默放行。不再需要风控时请清空本行（留空 = 关闭，行为与未配置完全一致）。
# 目标地址与通知 webhook 同一套 SSRF 校验：仅公网 http/https，每次请求前重校验，禁 3xx 跳转。
MK_ORDER_GATE_URL=
# 签名密钥（选填）：配置后请求带 x-mk-signature = HMAC-SHA256(密钥, 请求体原文) 的十六进制，
# 与卖家通知 webhook 同一套方案——风控服务只需实现一个校验器；留空则不签名（不带该头）。
MK_ORDER_GATE_SECRET=
# 单次请求超时（毫秒，默认 3000）：超时按"不可达"处理 → 拒单（fail-closed）
MK_ORDER_GATE_TIMEOUT_MS=3000

# ── 链上对账（自动修复镜像偏离）──
# 周期（毫秒，默认 600000=10 分钟）：把**仍停在非终态**、且静置超过 6 小时的订单逐个回读链上
# getOrder，若链上已终局/已争议则按与 watcher 相同的规则修复本地镜像（并留 Sync 镜像与店主告警）。
# 这是「事件漏扫 / 短重组 / 节点停机」的自动兜底；未配置托管合约时不启动。
MK_CHAIN_RECONCILE_MS=600000

# ── 个人数据保留（PIPL 类删除请求的机制）──
# 终局订单（确认/结算/退款/超时/取消）资金流结束后，收货信息/买家备注/争议陈述正文/证据附件
# 静置超过 N 天自动擦除（金额、状态、链上单号、支付哈希、事件史、评价均保留）；
# 0 = 关闭自动擦除（仍可手动调用 POST /api/shop/orders/:id/erase-pii）。默认 180 天。
MK_PII_RETENTION_DAYS=180
# 手动跑一轮保留期（POST /api/shop/retention/run）时，同一 days 的重复请求在这个窗口内
# 直接复用上次结果（挡前端超时重试/连点，避免同一份重活跑第二遍）。默认 2000 毫秒。
MK_PII_RETENTION_REUSE_MS=2000

# ── 汇率缓存 TTL（毫秒）与兜底 ──
# 标价单位是 USDT，链上只收原生 BTY ⇒ 只有**一条腿**：官方 BTY-USDT 行情
# （mainnet.bityuan.com/tapi/ticker）。它直接决定"买家要付多少 BTY"，所以 TTL 默认 60 秒。
# 0 = 每次请求都刷新（排障用，注意会打满上游，可能被限速）。
MK_BTY_TTL_MS=60000       # BTY-USDT（官方 ticker）：默认 60 秒
# 兜底汇率（官方行情取不到时使用，并标记 stale；0=不启用兜底）。
# 填了兜底，行情挂掉时你的店仍能按这个手工价下单；留 0 则宁可不报价（下单会被明确拒绝）。
MK_FALLBACK_BTY_USDT=0

# ── 认证 ──
# SIWE nonce 有效期（秒）：钱包签名的原文 10 分钟内有效。
MK_SIWE_TTL=600
# 登录令牌有效期（秒）：默认 30 天。前端把会话存在本机（localStorage），
# 这台设备签一次名后，在有效期内重新打开页面不需要再签。
# 令牌是无状态的 HMAC，服务端不能单独吊销——调大 = 更省事、泄露窗口同长；
# 要立刻让全部令牌失效只有换 MK_TOKEN_SECRET（所有人重新登录）。
MK_TOKEN_TTL=2592000
# 令牌签名密钥（生产必须设置强随机值，如 openssl rand -base64 32）
MK_TOKEN_SECRET=change-me-to-a-long-random-secret    # 必改：>=32 字符强随机值（openssl rand -base64 32），仓库示例值会被启动拒绝
# 注意：**没有**「放行弱密钥」的开关。缺失 / <32 字符 / 重复或纯数字 / 仓库公开的示例占位值一律
# 让 server.js process.exit(1) 拒绝启动（node/src/server.js 的 fail-fast），这是刻意设计——HMAC 令牌
# 用弱密钥可被任何人离线伪造店主身份。

# SIWE 登录签名原文身份：填写节点对外 API 域名（可带 https://，或 host[:port]）→ 钱包弹窗显示该域名、消息随节点而异；
# 留空依次回退 MK_REGISTER_ENDPOINT → MK_SHOP_OWNER（无域名部署以店主地址为店铺身份标识）
MK_SIWE_DOMAIN=

# ── 卖家通知 webhook 投递参数（URL/secret 在卖家面板「店铺设置」维护，此处仅保留网络调优）──
# 单次投递超时（毫秒）与失败重试退避基数（毫秒；最多重试 2 次，进程重启不补发）
MK_WEBHOOK_TIMEOUT_MS=5000
MK_WEBHOOK_RETRY_MS=2000
# 店主（owner）登录 webhook 告警：1=开启（auth.owner_login 事件，含地址与来源 IP；防钓鱼中继冒领店主令牌）
MK_OWNER_LOGIN_ALERT=0

# ── 存储 / CORS ──
# MySQL 8 连接（节点唯一的持久化依赖）。**数据模型：一个节点一个库，节点里的店铺都在这个库里**
# ——店铺是库里的行（shops 表 + 商品/订单上的 shop_code），不是一家店一个库。
# 所以同一台服务器上跑多个节点时，每个节点填**不同的 MK_DB_NAME**，共用一个 MySQL 实例即可；
# 两个节点填同一个库会被实例锁**拒绝启动**（那是设计约束，不是可配项）。
#
# ⚠️ Linux/macOS 的 deploy.sh 首次安装会询问 MySQL 并写入下面五项；Windows 的 deploy.ps1 仍需自己填。
#    外部 MySQL 账号需要：目标库权限 + SESSION_VARIABLES_ADMIN + 临时探针库的建表/触发器权限
#    （结构自检会在同实例建 `mk_schema_probe_<hash>`；权限不足时启动日志会打印 GRANT 示例）。
#    MK_DB_HOST / MK_DB_USER / MK_DB_NAME 缺失或为空 ⇒ 拒绝启动；MK_DB_PORT 默认 3306。
MK_DB_HOST=
MK_DB_PORT=3306
MK_DB_USER=
# 口令：空值**只在库就在本机（127.0.0.1 / localhost / ::1）时**才允许；
# 对着远程库配空口令会被门禁拦下（那等于把库当成没有认证的）。
MK_DB_PASSWORD=
# 本节点自己的库名。首次启动会尝试**自动建这个库**（CREATE DATABASE IF NOT EXISTS）——账号需要
# CREATE 权限；也可以预先手工建好。库名必须由你指定。
# 启动时的结构自检还会在同实例建一个由 MK_DB_NAME 派生的临时探针库；若账号只授权了目标库，
# 启动报错会原样打印需要补的那条 GRANT。
MK_DB_NAME=
# 连接池大小。读写都走池——写事务**不再**取全局行锁串行执行（四道"先读后写"的闸已各自落成计数器/唯一约束，见 src/db.js 文件头），调大对读写都有效
MK_DB_POOL_SIZE=10
# 等 **InnoDB 行锁**的上限（秒），落到会话的 innodb_lock_wait_timeout：超时报错，不无限等。
# 删掉全局写锁之后这条更重要：现在靠行级锁与带守卫的 UPDATE，等锁超时是它们唯一的兜底。
MK_DB_LOCK_WAIT_SECONDS=10
# 证据附件存储目录（默认 <进程工作目录>/attachments；容器部署请显式指向挂载卷；单文件 ≤2MB、单条 ≤6、单订单 ≤20MB）
MK_ATTACH_DIR=
# 允许跨域访问本节点的来源。
#   · 生产/类生产（含未设 NODE_ENV 的裸机与 systemd）**必须**填显式白名单，逗号分隔：
#       MK_CORS_ORIGIN=https://shop.example.com,https://market.example.com
#   · `*` 只在非生产环境下反射任意来源；类生产下 `*` 等于"不开放跨域"（连 ACAO 响应头都不发），
#     联邦前端与仲裁台的跨域调用会被浏览器静默拦截——这是"页面空白"最常见的原因。
#   · 确实要对所有人开放跨域**读取**时（本接口用 Bearer 令牌、无 Cookie）：
#       MK_CORS_ORIGIN=*
#       MK_CORS_ALLOW_ALL=1
# 启动日志会打印当前实际生效的口径，不猜。
MK_CORS_ORIGIN=*
# 仅当 MK_CORS_ORIGIN=* 时有意义：1 = 类生产环境下也反射任意来源（默认 0 = 关闭跨域）
MK_CORS_ALLOW_ALL=0

# ── 反向代理信任边界 / 来源 IP ──
# X-Forwarded-For 的唯一解析点。留空 = 不信任任何代理（req.ip 是 TCP 对端地址）；
# loopback = 只信任本机回环上的代理（宿主 nginx）；也可填逗号分隔的 IP/CIDR——
# deploy.sh 的 Caddy 是容器，节点看到的来源是 Docker 网段，按实际 Subnet 填（docker network inspect）。
# 节点在 Caddy / nginx 后面时**必须**设对来源网段：不设时所有匿名客户端共用代理那一个限流桶，
# 审计与请求日志里的来源 IP 也恒为代理地址。非法值会在配置入口直接报错。
# 部署脚本（deploy.sh / deploy.ps1）不管理这个键，重跑时原样保留。
MK_TRUST_PROXY=

# ── 优雅关闭 ──
# 收到 SIGTERM/SIGINT 后：停止收新连接 → 等在途响应 → 关库 → 退出。
# 超过这个毫秒数就强制退出（日志里会写明「在途连接可能未排空」）。默认 10000。
# ⚠️ 调大它的前提是容器编排的宽限期一起调大，否则宽限期一到还是 SIGKILL，等于没调。
MK_SHUTDOWN_DRAIN_MS=10000
