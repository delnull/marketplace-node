# ===== BitYuan 联邦商城节点配置样例（配置极简：只放「身份与接线」，见 docs/DECISIONS.md）=====
# 复制为 .env 后按需修改；`node --env-file-if-exists=.env` 自动加载（缺失时用默认值）
#
# 经营参数一律不在本文件：
#   店名/公告/店员白名单/通知 webhook  → 卖家面板「店铺设置」网页编辑（节点 kv 存储，即改即生效）
#   登记 endpoint                    → 开店向导网页填写（链上登记不含展示资料，无需配置/同步）

# HTTP 端口
MK_PORT=8080

# ── 店铺身份（必填）──
# 店主钱包地址：商品上架/发货等写操作要求 SIWE 签名地址 == 此地址（店主的链上身份锚点；
# 换店主：链上 transferNode 转让（见 docs/OPS_RUNBOOK.md §5.5 与 docs/ARCHITECTURE.md §2.2），不在本文件更换）
# 注意：留空=未配置（节点会告警且无法上架）；请勿填 0x000…0 占位（非空会被当作"已配置"）
MK_SHOP_OWNER=

# ── 链上（BTY EVM 主网）──
MK_RPC_URL=https://mainnet.bityuan.com/eth
MK_CHAIN_ID=2999
# 部署 Escrow/Registry 合约后填入（见 docs/DEPLOY_NODE.md「链上部署与登记」）。
# 均为必填：Escrow = 买家资金锁定的 canonical 托管；Registry = 开店登记目录。
# 必须与配套前端 VITE_ESCROW_ADDRESS / VITE_REGISTRY_ADDRESS 一致（同网络），否则开店向导拒绝登记。
# 注意：请勿填 0x000…0 占位——非空即视为已接入（会启动事件轮询/开放登记条件）
MK_ESCROW_ADDRESS=
MK_REGISTRY_ADDRESS=
# 换托管合约地址时的显式确认（默认不要设）：启动时节点会把 MK_ESCROW_ADDRESS 记进库（kv 锚点），
# 下次启动若发现地址变了、而本地还有**已上链的在途订单**（escrowed/shipped/disputed），默认**拒绝启动**
# ——那些单的托管资金在旧合约实例上，换个地址查不到也对不了账。显式设 1 才继续（后果自负，见报错正文）。
MK_ESCROW_CHANGE_ACK=
# 链上仲裁人地址（可选）：配置后订单详情对仲裁人开放裁决证据（免 RPC）；未配置时运行时读合约 arbiter() 并短缓存
MK_ARBITER_ADDRESS=
# 支付币种为全局约定：原生 BTY（2026-09 收敛，Escrow 合约仅接受 msg.value 入金，无币种配置）

# ── 托管参数 ──
# 托管超时（区块数）：BTY 5 秒/块 → 7 天 ≈ 120960
MK_ESCROW_TIMEOUT_BLOCKS=120960
# 事件轮询间隔（毫秒）
MK_ESCROW_POLL_MS=15000
# 起始扫描块（0=从当前最新块开始；建议填 Escrow 部署块高度避免漏扫历史事件）
MK_ESCROW_START_BLOCK=0

# 确认深度（区块数，默认 12；0 = 关闭）：只处理「链头 − N 块」之前的事件。
# 重组只回放日志不回滚已落地的终态，等 N 块再处理可从源头规避短重组造成的镜像错位；
# 代价是状态回写延迟约 N×5 秒（本地 anvil 演示请设 0，见 scripts/dev/dev-demo.mjs）。
MK_ESCROW_FINALITY_BLOCKS=12

# ── 订单 ──
# 草稿订单（已锁定未支付）自动关闭 TTL（分钟）：超时未支付置为 cancelled
MK_DRAFT_TTL_MINUTES=30
# 卡密自动交付：默认开——数字商品买家托管成功（链上 OrderCreated 回写/paid 确认）后，
# 码池有未用码则自动分配发码置 shipped，免卖家手动发货；置 0 关闭（仅手动交付）
MK_AUTO_DELIVER=1
# 成交订单可评价窗口（天，P0-1）：终局（确认收货/仲裁判付/超时释放）起 N 天内买家可评价
MK_REVIEW_TTL_DAYS=30

# ── 下单风控闸（可选，**默认关闭**；运营方自己的准入策略）──
# 语义：填了地址就当「本店要先问过自己的风控服务才肯卖」。每笔**草稿创建前**（本地校验已过、
# 库存尚未占用——被拒的单既不留订单行也不占库存），本节点向该地址 POST JSON：
#   { event:'order.gate', buyer, seller, productSlug, skuKey, quantity, amountWei,
#     cnyFen, shippingFeeCnyFen, at }
# **不含**收货人姓名/电话/地址与买家备注（风控不该成为个人信息外流通道）。
# 响应契约：HTTP 200 + JSON {"allow":true} → 放行；{"allow":false,"reason":"…"} → 拒单
# （reason 会展示给买家，前缀「本店风控未放行：」）；其它状态/形态（含 3xx 重定向、非 JSON、
# allow 缺失）一律拒单并在消息里带出实际 HTTP 状态。
# fail-closed：地址一旦配置，风控服务不可达 / 超时 / 应答异常都会**拒绝下单**——宁可少卖，
# 也不在风控失效时静默放行。不再需要风控时请清空本行（留空 = 关闭，行为与未配置完全一致）。
# 目标地址与通知 webhook 同一套 SSRF 校验：仅公网 http/https，每次请求前重校验，禁 3xx 跳转。
MK_ORDER_GATE_URL=
# 签名密钥（选填）：配置后请求带 x-mk-signature = HMAC-SHA256(密钥, 请求体原文) 的十六进制，
# 与卖家通知 webhook 同一套方案——风控服务只需实现一个校验器；留空则不签名（不带该头）。
MK_ORDER_GATE_SECRET=
# 单次请求超时（毫秒，默认 3000）：超时按"不可达"处理 → 拒单（fail-closed）
MK_ORDER_GATE_TIMEOUT_MS=3000

# ── 链上对账（自动修复镜像偏离）──
# 周期（毫秒，默认 600000=10 分钟）：把**仍停在非终态**、且静置超过 6 小时的订单逐个回读链上
# getOrder，若链上已终局/已争议则按与 watcher 相同的规则修复本地镜像（并留 Sync 镜像与店主告警）。
# 这是「事件漏扫 / 短重组 / 节点停机」的自动兜底；未配置托管合约时不启动。
MK_CHAIN_RECONCILE_MS=600000

# ── 个人数据保留（PIPL 类删除请求的机制）──
# 终局订单（确认/结算/退款/超时/取消）资金流结束后，收货信息/买家备注/争议陈述正文/证据附件
# 静置超过 N 天自动擦除（金额、状态、链上单号、支付哈希、事件史、评价均保留）；
# 0 = 关闭自动擦除（仍可手动调用 POST /api/shop/orders/:id/erase-pii）。默认 180 天。
MK_PII_RETENTION_DAYS=180

# ── 两条腿的汇率缓存 TTL（毫秒）──
# 行情分两条腿，缓存分开设：BTY 价要跟得紧（官方端点，直接决定买家付多少 BTY）；
# USDT→CNY 要缓存久（3 家免密钥公共接口，缓存就是可用性）。0 = 该腿每次请求都刷新（排障用）。
MK_BTY_TTL_MS=60000       # BTY-USDT（官方 ticker）：默认 60 秒
MK_RATES_TTL_MS=1800000   # USDT→CNY（3 家公共接口）：默认 30 分钟 = 每源 48 次/天；调小容易被限速
# 兜底汇率（官方 BTY 行情 + 公开 USDT-CNY 源全部不可用时使用，并标记 stale；0=不启用兜底）
# 填了兜底，行情源挂掉时你的店仍能按旧价下单；留 0 则宁可不报价（前端退化为"仅 CNY 标价"）。
MK_FALLBACK_BTY_USDT=0
MK_FALLBACK_USDT_CNY=0

# ── 认证 ──
MK_SIWE_TTL=600
MK_TOKEN_TTL=86400
# 令牌签名密钥（生产必须设置强随机值，如 openssl rand -base64 32）
MK_TOKEN_SECRET=change-me-to-a-long-random-secret    # 必改：>=32 字符强随机值（openssl rand -base64 32），仓库示例值会被启动拒绝
# 注意：**没有**「放行弱密钥」的开关。缺失 / <32 字符 / 重复或纯数字 / 仓库公开的示例占位值一律
# 让 server.js process.exit(1) 拒绝启动（node/src/server.js 的 fail-fast），这是刻意设计——HMAC 令牌
# 用弱密钥可被任何人离线伪造店主身份。

# SIWE 登录签名原文身份（2026-09 修复）：填写节点对外 API 域名（可带 https://，或 host[:port]）→ 钱包弹窗显示该域名、消息随节点而异；
# 留空依次回退 MK_REGISTER_ENDPOINT → MK_SHOP_OWNER（无域名部署以店主地址为店铺身份标识）
MK_SIWE_DOMAIN=

# ── 卖家通知 webhook 投递参数（URL/secret 在卖家面板「店铺设置」维护，此处仅保留网络调优）──
# 单次投递超时（毫秒）与失败重试退避基数（毫秒；最多重试 2 次，进程重启不补发）
MK_WEBHOOK_TIMEOUT_MS=5000
MK_WEBHOOK_RETRY_MS=2000
# 店主（owner）登录 webhook 告警：1=开启（auth.owner_login 事件，含地址与来源 IP；防钓鱼中继冒领店主令牌）
MK_OWNER_LOGIN_ALERT=0

# ── 存储 / CORS ──
MK_DB_FILE=marketplace-node.db
# 证据附件存储目录（P0-2；默认 <db 文件目录>/attachments；单文件 ≤2MB、单条 ≤6、单订单 ≤20MB）
MK_ATTACH_DIR=
# 允许跨域访问本节点的来源。
#   · 生产/类生产（含未设 NODE_ENV 的裸机与 systemd）**必须**填显式白名单，逗号分隔：
#       MK_CORS_ORIGIN=https://shop.example.com,https://market.example.com
#   · `*` 只在非生产环境下反射任意来源；类生产下 `*` 等于"不开放跨域"（连 ACAO 响应头都不发），
#     联邦前端与仲裁台的跨域调用会被浏览器静默拦截——这是"页面空白"最常见的原因。
#   · 确实要对所有人开放跨域**读取**时（本接口用 Bearer 令牌、无 Cookie）：
#       MK_CORS_ORIGIN=*
#       MK_CORS_ALLOW_ALL=1
# 启动日志会打印当前实际生效的口径，不猜。
MK_CORS_ORIGIN=*
# 仅当 MK_CORS_ORIGIN=* 时有意义：1 = 类生产环境下也反射任意来源（默认 0 = 关闭跨域）
MK_CORS_ALLOW_ALL=0
